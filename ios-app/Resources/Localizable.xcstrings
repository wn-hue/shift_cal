          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the schedule created by this app in Google Calendar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが作成したGoogleの勤務表を確認しています。"
