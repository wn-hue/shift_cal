        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末に残っている試用投稿"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的测试帖子"
          }
        }
      }
    },
    "물건을 받으러 갈 때는 본인 물건의 특징을 설명해 주세요. 신고·차단이나 개인정보 삭제는": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물건을 받으러 갈 때는 본인 물건의 특징을 설명해 주세요. 신고·차단이나 개인정보 삭제는"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When collecting an item, describe what makes it yours. For reports, blocking or personal data deletion, contact"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け取るときは、ご自身の品物の特徴を説明してください。通報・ブロックや個人情報の削除については、"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "领取物品时，请说明物品的特征。举报、屏蔽或删除个人信息，请联系"
          }
        }
      }
    },
    "으로 문의해 주세요.": {
