    },
    "검색한 노선을 찾지 못했어요. 호차, 지역, 정류장 이름을 확인하거나 공장과 탑승 시간을 바꿔 보세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색한 노선을 찾지 못했어요. 호차, 지역, 정류장 이름을 확인하거나 공장과 탑승 시간을 바꿔 보세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t find that route. Check the bus number, area or stop name, or try another factory or ride time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "路線が見つかりませんでした。号車・地域・停留所名を確認するか、工場や乗車時刻を変えてみてください。"
          }
        },
        "zh-Hans": {
