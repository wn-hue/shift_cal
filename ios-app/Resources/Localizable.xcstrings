    "날씨 정보를 확인하지 못했어요. 새로고침을 눌러 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨 정보를 확인하지 못했어요. 새로고침을 눌러 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check the weather. Please refresh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気を確認できませんでした。更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法查看天气，请刷新。"
          }
        }
      }
    },
    "시간별 비·눈 예보를 확인하지 못했어요.": {
