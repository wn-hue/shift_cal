      }
    },
    "기록이 변경됐어요. 다시 보내면 최신 내용을 반영해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록이 변경됐어요. 다시 보내면 최신 내용을 반영해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your records changed. Send again to apply the latest changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録が変わりました。送り直すと最新の内容を反映します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录已更改，重新发送可更新为最新内容。"
          }
        }
      }
    },
    "기록이 변경되어 보내기를 멈췄어요. 최신 내용을 확인한 뒤 다시 보내 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록이 변경되어 보내기를 멈췄어요. 최신 내용을 확인한 뒤 다시 보내 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending stopped because records changed. Check the latest records and send again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録が変わったため送信を止めました。最新の内容を確認して送り直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录发生变化，已停止发送。请确认最新内容后重发。"
          }
        }
      }
    },
    "계정이나 기록이 변경됐어요. 보낸 결과를 확인한 뒤 다시 시도해 주세요.": {
      "extractionState": "manual",
      "localizations": {
