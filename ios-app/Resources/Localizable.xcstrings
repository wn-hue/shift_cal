    "부서, 라인, 요청사항을 각각 300자 이내로 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부서, 라인, 요청사항을 각각 300자 이내로 입력해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep department, line and request to 300 characters each."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "部署・ライン・お願いはそれぞれ300文字以内で入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部门、生产线及要求各限300字。"
          }
        }
      }
    },
