        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup restored. Sync from My account to save it to your account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを読み込みました。アカウントに保存するには「マイアカウント」で同期してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份已恢复。如需保存至账号，请在“我的账号”中同步。"
          }
        }
      }
    },
    "선택한 파일로 현재 기록을 바꿔요. 지금 기록도 보관하려면 먼저 백업 파일로 저장해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일로 현재 기록을 바꿔요. 지금 기록도 보관하려면 먼저 백업 파일로 저장해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces your current records. Save a backup first if you want to keep them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の記録を選んだファイルに置き換えます。残したい場合は、先にバックアップを保存してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
