{
  "sourceLanguage": "ko",
  "strings": {
    "시급과 수당이 맞나요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시급과 수당이 맞나요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are these amounts correct?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時給と手当は正しいですか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些时薪和津贴金额正确吗？"
          }
        }
      }
    },
    "금액을 확인하면 설정이 끝나요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액을 확인하면 설정이 끝나요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the amounts to finish setup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額を確認すると設定が完了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认金额后即可完成设置。"
          }
        }
      }
    },
    "예, 맞아요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예, 맞아요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, save"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい、保存する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是的，保存"
          }
        }
      }
    },
    "아니요, 수정할게요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아니요, 수정할게요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No, edit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいえ、修正する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不，修改"
          }
        }
      }
    },
    "시급과 수당 수정": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시급과 수당 수정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit pay and allowances"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時給と手当の修正"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改时薪和津贴"
          }
        }
      }
    },
    "다른 금액만 고친 뒤 저장해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 금액만 고친 뒤 저장해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit any incorrect amounts, then save."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "異なる金額だけ修正して保存してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请修改有误的金额后保存。"
          }
        }
      }
    },
    "인식한 시급과 수당": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인식한 시급과 수당"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported pay and allowances"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取った時給と手当"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别的时薪和津贴"
          }
        }
      }
    },
    "문자에서 인식": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자에서 인식"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From your message"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージから取得"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从短信识别"
          }
        }
      }
    },
    "기존 입력 유지": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 입력 유지"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing amount kept"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力済みの金額を維持"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留已输入的金额"
          }
        }
      }
    },
    "확인 필요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 필요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs review"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が必要"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要确认"
          }
        }
      }
    },
    "수정에서 입력해 주세요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정에서 입력해 주세요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter when editing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修正画面で入力してください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在修改时输入"
          }
        }
      }
    },
    "인식하지 못한 시급은 ‘아니요, 수정할게요’에서 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인식하지 못한 시급은 ‘아니요, 수정할게요’에서 입력해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose “No, edit” to enter the missing hourly rate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「いいえ、修正する」で未取得の時給を入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择“不，修改”输入未识别的时薪。"
          }
        }
      }
    },
    "월 수당 금액이에요. 틀린 항목만 수정할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 수당 금액이에요. 틀린 항목만 수정할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly allowances. You can edit any incorrect item."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月の手当額です。異なる項目だけ修正できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是每月津贴金额，可仅修改有误的项目。"
          }
        }
      }
    },
    "문자 원문은 저장하지 않아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자 원문은 저장하지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your original message is not saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージの原文は保存しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不保存短信原文。"
          }
        }
      }
    },
    "문자 또는 직접 입력한 금액": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자 또는 직접 입력한 금액"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported or manually entered"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージまたは手入力の金額"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短信或手动输入的金额"
          }
        }
      }
    },
    "자동 계산으로": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 계산으로"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use automatic calculation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動計算に戻す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用自动计算"
          }
        }
      }
    },
    "고정수당을 알려주세요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정수당을 알려주세요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us your fixed allowances"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定手当を教えてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写固定津贴"
          }
        }
      }
    },
    "수당 종류를 고르고 매월 받는 금액을 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수당 종류를 고르고 매월 받는 금액을 입력해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an allowance and enter the amount you receive each month."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手当の種類を選び、毎月受け取る金額を入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择津贴种类，输入每月领取的金额。"
          }
        }
      }
    },
    "수당 선택": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수당 선택"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose allowance"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手当を選択"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择津贴"
          }
        }
      }
    },
    "직접 추가할 수당이 없어요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 추가할 수당이 없어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No allowances to add manually"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手入力する手当はありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需手动添加津贴"
          }
        }
      }
    },
    "고정수당 종류": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정수당 종류"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowance type"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手当の種類"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "津贴种类"
          }
        }
      }
    },
    "고정수당 입력": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정수당 입력"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed allowances"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定手当の入力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写固定津贴"
          }
        }
      }
    },
    "기타 고정수당": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기타 고정수당"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other allowance"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他の固定手当"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他固定津贴"
          }
        }
      }
    },
    "기타수당": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기타수당"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他津贴"
          }
        }
      }
    },
    "＋ 수당 추가": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 수당 추가"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ Add allowance"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 手当を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 添加津贴"
          }
        }
      }
    },
    "수당 종류를 선택해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수당 종류를 선택해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an allowance type."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手当の種類を選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择津贴种类。"
          }
        }
      }
    },
    "이미 선택한 수당이에요. 다른 종류를 선택해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 선택한 수당이에요. 다른 종류를 선택해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This allowance is already selected. Choose another type."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択済みの手当です。別の種類を選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择此津贴，请选择其他种类。"
          }
        }
      }
    },
    "시급과 수당을 확인해 주세요. 금액을 직접 입력해도 돼요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시급과 수당을 확인해 주세요. 금액을 직접 입력해도 돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review your hourly pay and allowances. You can enter amounts manually."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時給と手当をご確認ください。金額を直接入力することもできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认时薪和津贴，也可以直接输入金额。"
          }
        }
      }
    },
    "급여 문자를 복사한 뒤 아래 버튼을 누르면 시급·수당이 자동으로 채워져요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급여 문자를 복사한 뒤 아래 버튼을 누르면 시급·수당이 자동으로 채워져요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy your pay message, then tap below to fill in your hourly pay and allowances."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "給与メッセージをコピーして下のボタンを押すと、時給と手当が自動入力されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制工资短信后，点击下方按钮即可自动填写时薪和津贴。"
          }
        }
      }
    },
    "입사일 기준 자동 계산": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입사일 기준 자동 계산"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated from your start date"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入社日をもとに自動計算"
          }
        },
