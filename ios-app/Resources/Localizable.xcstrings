        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時給・手当は手入力した金額を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时薪和津贴使用手动输入的金额。"
          }
        }
      }
    },
    "계정 연결 시 공제 설정도 본인 계정에 저장돼요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 연결 시 공제 설정도 본인 계정에 저장돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an account is connected, deduction settings are also saved to your account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
