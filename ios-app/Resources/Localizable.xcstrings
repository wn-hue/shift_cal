        }
      }
    },
    "다른 곳에서 일정이 변경됐어요. 최신 상태를 다시 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 곳에서 일정이 변경됐어요. 최신 상태를 다시 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event changed elsewhere. Check its latest state."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の場所で予定が変更されました。最新の状態を再確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日程已在其他位置更改，请重新确认最新状态。"
          }
        }
      }
    },
    "일부 일정의 응답을 확인하지 못했어요. 다시 보내면 기존 일정을 확인한 뒤 이어서 처리해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 일정의 응답을 확인하지 못했어요. 다시 보내면 기존 일정을 확인한 뒤 이어서 처리해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't confirm some event responses. Sending again checks existing events before continuing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の予定の応答を確認できませんでした。送り直すと既存の予定を確認して続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分日程响应未确认。重新发送时会先检查已有日程再继续。"
          }
        }
      }
    },
    "Google 캘린더에 근무표 보내기": {
