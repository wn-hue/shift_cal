          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports are open on weekdays from 06:50 to 07:30."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平日06:50～07:30に報告できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
