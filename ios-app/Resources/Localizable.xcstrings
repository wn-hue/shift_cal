    "서로 다른 금액이 섞여 있어요. 한 달치 명세서만 붙여넣어 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서로 다른 금액이 섞여 있어요. 한 달치 명세서만 붙여넣어 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message contains conflicting amounts. Paste a payslip for just one month."
