    },
    "오늘 주간 근무자만 제보할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 주간 근무자만 제보할 수 있어요."
