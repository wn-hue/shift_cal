    "위치 권한이 꺼져 있어요. 장소나 주소로 찾아보세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 권한이 꺼져 있어요. 장소나 주소로 찾아보세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location permission is off. Search by place or address."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報の利用が許可されていません。場所や住所で探してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位权限已关闭，请按地点或地址搜索。"
          }
        }
      }
    },
    "현재 위치를 확인하지 못했어요. 다시 시도하거나 장소나 주소로 찾아보세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치를 확인하지 못했어요. 다시 시도하거나 장소나 주소로 찾아보세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t find your current location. Try again or search by place or address."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地を確認できませんでした。もう一度試すか、場所や住所で探してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取当前位置，请重试或按地点或地址搜索。"
          }
        }
      }
    },
    "잃어버린 물건을 찾거나 주운 물건을 알릴 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잃어버린 물건을 찾거나 주운 물건을 알릴 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for something you lost or let others know what you found."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なくした物を探したり、拾った物を知らせたりできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以寻找丢失的物品，也可以发布捡到的物品。"
          }
        }
      }
    },
    "숨긴 작성자 모두 다시 보기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
