          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For remaining leave"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りの有休分"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按剩余年假"
          }
        }
      }
    },
    "통상시급 × 8시간 × 남은 연차로 예상해요. 실제 지급 조건과 금액은 회사 기준에 따라 달라질 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통상시급 × 8시간 × 남은 연차로 예상해요. 실제 지급 조건과 금액은 회사 기준에 따라 달라질 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated as ordinary hourly pay × 8 hours × remaining leave. Actual eligibility and amounts follow company rules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常時給×8時間×残りの有休で予想します。実際の支給条件や金額は会社の基準により異なります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按通常时薪×8小时×剩余年假估算。实际支付条件和金额以公司规定为准。"
          }
        }
      }
    },
    "날짜를 변경하면 연도별로 직접 설정한 연차를 초기화하고 자동으로 다시 계산해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜를 변경하면 연도별로 직접 설정한 연차를 초기화하고 자동으로 다시 계산해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing this date resets manual yearly leave totals and recalculates them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付を変更すると、年ごとに手入力した有休をリセットして再計算します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改日期将重置各年手动设置的年假并重新自动计算。"
          }
        }
      }
    },
