      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 저장한 기록을 삭제할까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your account and saved records?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントと保存した記録を削除しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除账号及已保存记录？"
          }
        }
      }
    },
    "계정에 저장한 근무표·메모·설정, 본인이 쓴 분실물 글과 공유 링크를 삭제해요. 외부로 내보낸 파일과 Google 캘린더 일정은 별도로 남아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에 저장한 근무표·메모·설정, 본인이 쓴 분실물 글과 공유 링크를 삭제해요. 외부로 내보낸 파일과 Google 캘린더 일정은 별도로 남아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes account schedules, notes and settings, your lost-and-found posts and share links. Exported files and Google Calendar events remain separately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの勤務表・メモ・設定、自分の落とし物投稿と共有リンクを削除します。書き出したファイルとGoogleカレンダーの予定は別に残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除账号中的班表、备注、设置、您发布的失物招领帖子及分享链接。已导出的文件及Google日历日程会另行保留。"
          }
        }
      }
    },
