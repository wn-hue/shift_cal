          }
        }
      }
    },
    "공제 문자는 나중에 등록해도 돼요. 등록하지 않으면 기존 기본 비율로 세후 금액을 예상해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공제 문자는 나중에 등록해도 돼요. 등록하지 않으면 기존 기본 비율로 세후 금액을 예상해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add a payslip later. Until then, net pay uses the default deduction estimate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "控除の明細は後から登録できます。未登録の場合は標準の比率で手取りを予想します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工资短信可稍后添加，未添加时按默认比例估算税后金额。"
          }
        }
      }
