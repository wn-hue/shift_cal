    "메모를 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모를 입력해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a note first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先输入备注。"
          }
        }
      }
    },
    "종료 시간은 시작 시간보다 늦게 설정해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시간은 시작 시간보다 늦게 설정해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the end time after the start time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時刻は開始時刻より後にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束时间须晚于开始时间。"
          }
        }
      }
    },
    "장소는 300자까지 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소는 300자까지 입력해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the location to 300 characters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所は300文字以内で入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地点最多输入300字。"
          }
        }
      }
    },
    "반복 종료일은 시작일 이후로 설정해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복 종료일은 시작일 이후로 설정해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the repeat end date after the start date."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しの終了日は開始日以降にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复结束日期须在开始日期之后。"
          }
        }
      }
    },
    "하루에 일정은 50개까지 저장할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루에 일정은 50개까지 저장할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can save up to 50 events per day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定は1日50件まで保存できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天最多保存50个日程。"
          }
        }
      }
    },
    "하루 메모는 50개, 총 16,000자까지 저장할 수 있어요.": {
