          }
        }
      }
    },
    "켜면 함께 제보하고 만차 알림을 받아요. 끄면 제보와 알림을 모두 쉬어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 함께 제보하고 만차 알림을 받아요. 끄면 제보와 알림을 모두 쉬어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on to report parking and receive full-lot alerts. Turn off to pause both."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンで情報提供と満車通知に参加します。オフにすると両方お休みします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后可报告并接收满车位提醒；关闭后两项同时暂停。"
          }
        }
      }
    },
