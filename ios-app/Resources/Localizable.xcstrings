          }
        }
      }
    },
    "분실물 글을 불러오는 중…": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분실물 글을 불러오는 중…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading lost & found posts…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "落とし物の投稿を読み込み中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在加载失物招领帖子…"
          }
        }
      }
    },
    "분실물 글을 불러오지 못했어요. 새로고침해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분실물 글을 불러오지 못했어요. 새로고침해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load lost & found posts. Please refresh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "落とし物の投稿を読み込めませんでした。更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能加载失物招领帖子。请刷新。"
          }
        }
      }
    },
    "같은 계정으로 로그인하면 다른 기기에서도 내 글을 관리할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 계정으로 로그인하면 다른 기기에서도 내 글을 관리할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with the same account to manage your posts on other devices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じアカウントでログインすると、別の端末でも自分の投稿を管理できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用同一个账号登录后，也可以在其他设备上管理自己的帖子。"
          }
        }
      }
    },
    "누구나 글을 볼 수 있어요. 글을 올리거나 관리·신고하려면 Google 또는 Apple로 로그인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구나 글을 볼 수 있어요. 글을 올리거나 관리·신고하려면 Google 또는 Apple로 로그인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone can view posts. Sign in with Google or Apple to post, manage your posts or report one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿は誰でも閲覧できます。投稿の作成・管理や通報をするには、Google または Apple でログインしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都可以查看帖子。要发布、管理或举报帖子，请使用 Google 或 Apple 登录。"
          }
        }
      }
    },
    "글을 삭제할까요? 삭제한 글은 되돌릴 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글을 삭제할까요? 삭제한 글은 되돌릴 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this post? You can’t recover it once it’s deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿を削除しますか？削除した投稿は復元できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除这个帖子吗？删除后无法恢复。"
          }
        }
      }
    },
    "글쓰기에 불러오기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글쓰기에 불러오기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load into editor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集欄に読み込む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载到编辑区"
          }
        }
      }
    },
    "테스트 글을 불러왔어요. 게시물 등록을 누르면 앱에 공개돼요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트 글을 불러왔어요. 게시물 등록을 누르면 앱에 공개돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test post loaded. Tap Publish post to make it visible in the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試用投稿を読み込みました。「投稿する」をタップするとアプリ内に公開されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已加载测试帖子。点击“发布信息”后，帖子会在应用中公开。"
          }
        }
      }
    },
    "입사일을\n알려 주세요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입사일을\n알려 주세요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When did you start?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入社日を\n教えてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请告诉我们\n您的入职日期"
          }
        }
      }
    },
    "어느 조에서\n일하시나요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 조에서\n일하시나요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which team do you work on?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの勤務グループで\n働いていますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您在哪个班组工作？"
          }
        }
      }
    },
    "시급을 입력하면\n준비가 끝나요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시급을 입력하면\n준비가 끝나요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your hourly pay to finish setup"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時給を入力すれば\n準備完了です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入时薪即可\n完成设置"
          }
        }
      }
    },
    "입사일을 기준으로 연차와\n예상 급여를 계산해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입사일을 기준으로 연차와\n예상 급여를 계산해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use your start date to calculate leave and estimated pay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入社日をもとに有休と給与の目安を計算します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会根据入职日期计算年假和预估工资。"
          }
        }
      }
    },
    "시급을 입력하면\n예상 급여를 볼 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시급을 입력하면\n예상 급여를 볼 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your hourly pay to see your estimated pay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時給を入力すると給与の目安を確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入时薪即可查看预估工资。"
          }
        }
      }
    },
    "입사일을\n알려주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입사일을\n알려주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When did you join?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入社日を\n教えてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请告诉我们\n您的入职日期"
          }
        }
      }
    },
    "어느 조에서\n근무하시나요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
