          "stringUnit": {
            "state": "translated",
            "value": "Which team are\nyou on?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの組で\n働いていますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您在哪个\n班组工作？"
          }
        }
      }
    },
    "시급을 설정하면\n준비가 끝나요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시급을 설정하면\n준비가 끝나요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your hourly pay\nand you’re ready"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時給を設定すれば\n準備完了です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置好时薪\n就准备好了"
          }
        }
      }
    },
    "내 연차와 예상 급여를\n계산하는 기준이에요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 연차와 예상 급여를\n계산하는 기준이에요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is used to estimate\nyour leave and pay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有休と予想給与の\n計算基準になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于计算您的\n年假和预估工资。"
          }
        }
      }
    },
    "선택한 조에 맞춰\n내 근무표를 만들어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 조에 맞춰\n내 근무표를 만들어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll create your schedule\nfor the team you choose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ勤務組に合わせて\n勤務表を作成します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据您选择的班组\n生成您的排班表。"
          }
        }
      }
    },
    "시급을 확인하면\n내 예상 급여를 볼 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시급을 확인하면\n내 예상 급여를 볼 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your hourly rates\nto see your estimated pay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時給を確認すると\n予想給与がわかります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认时薪后\n即可查看预估工资。"
          }
        }
      }
    },
    "기본시급·통상시급과 받는 수당을 직접 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본시급·통상시급과 받는 수당을 직접 입력해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your base and ordinary hourly rates and allowances."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本時給・通常時給と手当を入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请手动输入基本时薪、通常时薪和津贴。"
          }
        }
      }
    },
    "세금 추정": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세금 추정"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated deductions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "税金の見積もり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "税费估算"
          }
        }
      }
    },
    "세금·보험료를 추정해요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세금·보험료를 추정해요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate taxes and insurance"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "税金・保険料を見積もります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "估算税费和保险费"
          }
        }
      }
    },
    "세금·보험료와 실수령액은 추정치예요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세금·보험료와 실수령액은 추정치예요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxes, insurance and take-home pay are estimates."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "税金・保険料と手取り額は推定値です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "税费、保险费和实发工资均为估算值。"
          }
        }
      }
    },
    "세금·보험료와 실수령액은 추정치예요. 실제 명세서와 다를 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세금·보험료와 실수령액은 추정치예요. 실제 명세서와 다를 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxes, insurance and take-home pay are estimates and may differ from your payslip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "税金・保険料と手取り額は推定値です。実際の明細と異なる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
