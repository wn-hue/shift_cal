            "state": "translated",
            "value": "나의 %@조는 회색으로, 오늘은 파란색으로 표시해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your team %@ is gray, and today is blue."
          }
        },
        "ja": {
