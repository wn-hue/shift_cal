            "state": "translated",
            "value": "本日の日勤者のみ報告できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当天白班员工可反馈。"
          }
        }
      }
    },
    "주차장 만차 알림": {
      "extractionState": "manual",
