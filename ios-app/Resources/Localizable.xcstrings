    "상여 문자로 공제 기준 가져오기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상여 문자로 공제 기준 가져오기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import deductions from bonus SMS"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
