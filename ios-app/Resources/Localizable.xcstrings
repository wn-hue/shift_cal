        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone满车位提醒正在准备中，目前可查看停车情况。"
          }
        }
      }
    },
    "제보에 참여하고 만차 알림을 받아요.": {
