    "오늘도 안전하게! 퇴근하시는 분들은 푹 쉬세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘도 안전하게! 퇴근하시는 분들은 푹 쉬세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay safe today! Rest well if you're heading home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日も安全に！退勤する方はゆっくり休んでください。"
          }
        },
        "zh-Hans": {
