    },
    "아이폰의 알람 예약 한도에 도달해 %d개는 아직 예약하지 못했어요. 앱을 다시 열면 남은 알람을 이어서 예약해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이폰의 알람 예약 한도에 도달해 %d개는 아직 예약하지 못했어요. 앱을 다시 열면 남은 알람을 이어서 예약해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone's scheduling limit was reached; %d alarms are not yet scheduled. Reopen the app to schedule the rest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの予約上限に達したため、%d件は未予約です。アプリを開き直すと残りを続けて予約します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达iPhone预约上限，尚有%d个闹钟未预约。重新打开应用后会继续预约。"
          }
        }
      }
    },
