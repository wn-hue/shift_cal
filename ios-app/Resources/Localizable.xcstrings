          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hourly precipitation · Rain and snow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間ごとの降水確率・雨と雪の予報"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每小时降水概率 · 雨雪预报"
          }
        }
      }
    },
    "현재 위치는 선택 사항이에요. 대략적인 좌표를 Open-Meteo에 보내 날씨를 조회하며, 위치는 저장하거나 계정에 동기화하지 않아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치는 선택 사항이에요. 대략적인 좌표를 Open-Meteo에 보내 날씨를 조회하며, 위치는 저장하거나 계정에 동기화하지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is optional. Approximate coordinates are sent to Open-Meteo for weather only. Your location isn't saved or synced to your account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の利用は任意です。おおよその座標をOpen-Meteoに送って天気を確認します。位置情報は保存・アカウント同期しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用当前位置为可选项。大致坐标仅发送至Open-Meteo查询天气，不会保存或同步至账号。"
          }
        }
      }
    },
