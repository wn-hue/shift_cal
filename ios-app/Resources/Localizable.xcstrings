            "value": "投稿を削除しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帖子已删除。"
          }
        }
      }
    },
    "변경 내용을 저장했어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 내용을 저장했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
