            "value": "从2026年11月2日起生效。"
          }
        }
      }
    },
    "주간 출근 2호차와 6호차 모두 07:12에 안산역건너(진성고시텔)에 들러요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 출근 2호차와 6호차 모두 07:12에 안산역건너(진성고시텔)에 들러요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day-shift buses 2 and 6 both stop at 안산역건너(진성고시텔) at 07:12."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日勤の出勤バス2号車と6号車はどちらも07:12に안산역건너(진성고시텔)に停車します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白班上班班车2号和6号均于07:12停靠안산역건너(진성고시텔)。"
          }
        }
      }
    },
    "바뀌는 날 전까지는 기존 노선이 검색돼요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바뀌는 날 전까지는 기존 노선이 검색돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search results use the current routes until the effective date."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更日までは現在の路線が検索結果に表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生效前仍可搜索现有线路。"
          }
        }
      }
    },
    "선택한 정류장에 서는 버스만 보여 드려요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 정류장에 서는 버스만 보여 드려요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing buses that stop at the selected stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ停留所に停まるバスを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示停靠所选站点的班车。"
          }
        }
      }
    },
    "직선거리 500m 안에서 가까운 순서대로 보여 드려요. 걸어서 얼마나 걸리는지는 길찾기에서 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직선거리 500m 안에서 가까운 순서대로 보여 드려요. 걸어서 얼마나 걸리는지는 길찾기에서 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing stops within 500 m, sorted by straight-line distance. Check walking time in Directions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直線距離500m以内の停留所を近い順に表示します。徒歩の所要時間は経路検索で確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示直线距离500米以内的站点，按距离由近到远排列。步行时间请在路线导航中查看。"
          }
        }
      }
    },
    "선택한 정류장에 서는 버스가 없어요. 공장이나 탑승 시간을 바꿔 보세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 정류장에 서는 버스가 없어요. 공장이나 탑승 시간을 바꿔 보세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No buses stop at the selected stop. Try a different factory or ride time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ停留所に停まるバスがありません。工場や乗車時刻を変えてみてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有班车停靠所选站点。请更换工厂或乘车时间。"
          }
        }
      }
    },
    "2km 이내에 탈 수 있는 버스가 없어요. 장소나 검색 조건을 바꿔 보세요.": {
      "extractionState": "manual",
