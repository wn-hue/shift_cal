          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is checked only when reporting and is not saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報提供のときだけ位置を確認し、保存はしません。"
