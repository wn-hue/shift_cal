    },
    "현재 위치를 사용할 수 없어요. 장소나 주소로 찾아보세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치를 사용할 수 없어요. 장소나 주소로 찾아보세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current location is unavailable. Search by place or address."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地を使えません。場所や住所で探してください。"
