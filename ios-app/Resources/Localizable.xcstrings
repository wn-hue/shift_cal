      }
    },
    "근속수당 금액을 읽지 못했어요. 설정한 금액을 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근속수당 금액을 읽지 못했어요. 설정한 금액을 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the seniority allowance. Check the amount in your settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤続手当の金額を読み取れませんでした。設定した金額を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取工龄津贴。请检查已设置的金额。"
          }
        }
      }
    },
    "국민연금과 건강보험료(장기요양보험료 포함)는 문자에 적힌 월 금액을 사용해요. 소득세와 지방소득세는 문자에 나온 비율로 예상해요. 보험료 정산이나 신고보수, 비과세 항목에 변경이 있으면 새 문자를 등록해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "국민연금과 건강보험료(장기요양보험료 포함)는 문자에 적힌 월 금액을 사용해요. 소득세와 지방소득세는 문자에 나온 비율로 예상해요. 보험료 정산이나 신고보수, 비과세 항목에 변경이 있으면 새 문자를 등록해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "National pension and health insurance, including long-term care insurance, use the monthly amounts in your message. Income tax and local income tax are estimated using the rates from the message. Add a new message if insurance adjustments, reported wages, or tax-exempt items change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国民年金と健康保険料（長期療養保険料を含む）は、SMSに記載された月額を使います。所得税と地方所得税は、SMSに記載された割合で見積もります。保険料の精算、届出報酬、非課税項目に変更があれば、新しいSMSを登録してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国民年金和医保（含长期护理保险）按短信中的月缴金额计算。所得税和地方所得税按短信中的比例估算。若保费结算、申报薪酬或免税项目有变化，请添加新短信。"
          }
        }
      }
    },
    "문자에 적힌 고용보험료가 지급액의 0.9%와 달라요. 문자에 나온 비율로 예상해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자에 적힌 고용보험료가 지급액의 0.9%와 달라요. 문자에 나온 비율로 예상해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The employment insurance amount in your message differs from 0.9% of gross pay. We estimate it using the rate from the message."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SMSに記載された雇用保険料が支給額の0.9%と異なるため、SMSの割合で見積もります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短信中的就业保险费不等于应发工资的0.9%。按短信中的比例估算。"
          }
        }
      }
    },
    "지급 합계와 공제 합계를 확인하지 못했어요. 두 합계가 모두 있고 세부 내역과 맞는지 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지급 합계와 공제 합계를 확인하지 못했어요. 두 합계가 모두 있고 세부 내역과 맞는지 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't verify the payment and deduction totals. Check that both totals appear and match the details."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支給合計と控除合計を確認できませんでした。両方の合計があり、明細と一致するか確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认应发和扣除合计。请检查两项合计是否都有且与明细一致。"
          }
        }
      }
    },
    "지급 합계와 공제 합계가 함께 적힌 문자를 붙여넣어 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지급 합계와 공제 합계가 함께 적힌 문자를 붙여넣어 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a message that includes both payment and deduction totals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支給合計と控除合計の両方が記載されたSMSを貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请粘贴同时包含应发和扣除合计的短信。"
          }
        }
      }
    },
    "시급이나 수당을 읽지 못했어요. 지급 내역과 공제 내역이 모두 있는 명세서를 붙여넣어 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시급이나 수당을 읽지 못했어요. 지급 내역과 공제 내역이 모두 있는 명세서를 붙여넣어 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read hourly pay or allowances. Paste a payslip that includes payment and deduction details."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時給や手当を読み取れませんでした。支給と控除の内訳が両方記載された明細を貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取时薪或津贴。请粘贴同时包含应发和扣除明细的工资单。"
          }
        }
      }
    },
    "총 지급액을 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "총 지급액을 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your total gross pay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "総支給額を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查应发合计。"
          }
        }
      }
    },
    "세금과 보험료 계산 기준을 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세금과 보험료 계산 기준을 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the rates used to estimate taxes and insurance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "税金と保険料の計算基準を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查税费和保险费的估算依据。"
          }
        }
      }
    },
    "저장하지 못했어요. 입력한 내용을 확인하고 다시 시도해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 못했어요. 입력한 내용을 확인하고 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save. Check your entries and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できませんでした。入力内容を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存失败。请检查输入后重试。"
          }
        }
      }
    },
    "설정을 저장했어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 저장했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を保存しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置已保存。"
          }
        }
      }
    },
    "평일 06:50~07:30 제보": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평일 06:50~07:30 제보"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report weekdays, 06:50–07:30"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平日06:50〜07:30に報告できます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作日06:50～07:30可上报"
          }
        }
      }
    },
    "본사·1공장 반경 1km 안에서 제보할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본사·1공장 반경 1km 안에서 제보할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can report within 1 km of HQ / Factory 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本社・第1工場から1km以内で報告できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在总部·1工厂1公里范围内可以上报。"
          }
        }
      }
    },
    "주간 근무자의 최근 10분 제보를 모아 보여 드려요. 실제로 주차할 수 있는지는 현장 상황에 따라 달라요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 근무자의 최근 10분 제보를 모아 보여 드려요. 실제로 주차할 수 있는지는 현장 상황에 따라 달라요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We show reports from day-shift workers over the last 10 minutes. Actual parking availability may vary."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日勤の方から直近10分間に届いた報告をまとめて表示します。実際に駐車できるかは現地の状況によります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里汇总白班同事最近10分钟的上报。是否有空位，以现场情况为准。"
          }
        }
      }
    },
    "현재 상태를 눌러 제보해 주세요. 같은 상태를 다시 누르면 취소돼요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 상태를 눌러 제보해 주세요. 같은 상태를 다시 누르면 취소돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the current status to report it. Tap the same status again to undo it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の状況をタップして報告できます。同じ状況をもう一度タップすると取り消せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点选当前状态即可上报。再次点选同一状态即可撤销。"
          }
        }
      }
    },
    "제보와 만차 알림은 함께 켜고 꺼요. 아이폰에서는 홈 화면에 앱을 추가한 뒤 알림 권한을 허용해 주세요. 알림 소리는 기기의 알림과 집중 모드 설정을 따라요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제보와 만차 알림은 함께 켜고 꺼요. 아이폰에서는 홈 화면에 앱을 추가한 뒤 알림 권한을 허용해 주세요. 알림 소리는 기기의 알림과 집중 모드 설정을 따라요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporting and full-lot alerts turn on and off together. On iPhone, add the app to your Home Screen, then allow notifications. Alert sounds follow your device’s notification and Focus settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状況報告と満車通知は同時にオン・オフできます。iPhoneではホーム画面にアプリを追加してから通知を許可してください。通知音は端末の通知と集中モードの設定に従います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上报和满位提醒会同时开启或关闭。在 iPhone 上，请先将应用添加到主屏幕，再允许通知。提醒声音遵循设备的通知和专注模式设置。"
          }
        }
      }
    },
    "스위치를 켜면 주차 상태를 제보하고 만차 알림을 받을 수 있어요. 끄면 둘 다 중단돼요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스위치를 켜면 주차 상태를 제보하고 만차 알림을 받을 수 있어요. 끄면 둘 다 중단돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the switch to report parking status and get full-lot alerts. Turning it off stops both."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチをオンにすると、駐車状況を報告して満車通知を受け取れます。オフにすると両方が停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启开关后就能上报停车状态并接收满位提醒。关闭后两项功能都会停止。"
          }
        }
      }
    },
    "제보할 수 있는 위치인지 확인할 때만 위치를 서버로 보내요. 위치는 저장하지 않아요. 위치 오차가 300m를 넘으면 다시 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제보할 수 있는 위치인지 확인할 때만 위치를 서버로 보내요. 위치는 저장하지 않아요. 위치 오차가 300m를 넘으면 다시 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We send your location to the server only to check whether you can report from there. We don’t store it. Check again if the location accuracy is worse than 300 m."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告できる場所かを確認する場合に限り、位置情報をサーバーに送信します。位置情報は保存しません。位置の誤差が300mを超える場合は再確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在确认当前位置是否可以上报时，才会将位置发送到服务器。位置信息不会保存。如果定位误差超过300米，请重新确认。"
          }
        }
      }
    },
    "제보하려면 아래 스위치를 켜 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제보하려면 아래 스위치를 켜 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the switch below to report."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告するには下のスイッチをオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要上报，请开启下方的开关。"
          }
        }
      }
    },
    "평일 06:50~07:30에 제보할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평일 06:50~07:30에 제보할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can report on weekdays from 06:50 to 07:30."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平日06:50〜07:30に報告できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作日06:50～07:30可以上报。"
          }
        }
      }
    },
    "이 앱이나 브라우저에서 위치를 확인할 수 없어요. 위치 확인이 가능한 앱이나 브라우저에서 열어 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱이나 브라우저에서 위치를 확인할 수 없어요. 위치 확인이 가능한 앱이나 브라우저에서 열어 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app or browser can’t check your location. Open the page in an app or browser that supports location."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリやブラウザでは位置情報を取得できません。位置情報に対応するアプリやブラウザで開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用或浏览器无法获取位置。请使用支持定位的应用或浏览器打开。"
          }
        }
      }
    },
    "최근 10분 동안 만차 제보가 5건 이상 들어왔어요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 10분 동안 만차 제보가 5건 이상 들어왔어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least five full-lot reports in the last 10 minutes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近10分間に満車の報告が5件以上ありました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近10分钟收到至少5条满位上报"
          }
        }
      }
    },
    "주차장 정보를 불러오지 못했어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주차장 정보를 불러오지 못했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load parking information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駐車場の情報を読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能加载停车场信息。"
          }
        }
      }
    },
    "주차장 정보를 불러오는 데 시간이 걸려요. 새로고침해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주차장 정보를 불러오는 데 시간이 걸려요. 새로고침해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parking information is taking longer to load. Please refresh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駐車場の情報の読み込みに時間がかかっています。更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载停车场信息需要更长时间。请刷新。"
          }
        }
      }
    },
    "알림 연결이 끊겼어요. 스위치를 다시 켜 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 연결이 끊겼어요. 스위치를 다시 켜 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts were disconnected. Turn the switch back on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の接続が切れました。スイッチをもう一度オンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒连接已断开。请重新打开开关。"
          }
        }
      }
    },
    "알림을 설정하지 못했어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 설정하지 못했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t set up alerts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を設定できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能设置提醒。"
          }
        }
      }
    },
    "이 브라우저에서는 알림을 받을 수 없어요. 아이폰에서는 Safari에서 홈 화면에 추가한 앱을 열어 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브라우저에서는 알림을 받을 수 없어요. 아이폰에서는 Safari에서 홈 화면에 추가한 앱을 열어 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This browser can’t receive alerts. On iPhone, open the app you added to your Home Screen from Safari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブラウザでは通知を受け取れません。iPhoneではSafariからホーム画面に追加したアプリを開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此浏览器无法接收提醒。在 iPhone 上，请打开从 Safari 添加到主屏幕的应用。"
          }
        }
      }
    },
    "만차 알림을 받으려면 알림 권한을 허용해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만차 알림을 받으려면 알림 권한을 허용해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications to get full-lot alerts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "満車通知を受け取るには通知を許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要接收满位提醒，请允许通知。"
          }
        }
      }
    },
    "주차장 화면을 새로고침한 뒤 다시 켜 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주차장 화면을 새로고침한 뒤 다시 켜 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the parking screen, then turn it back on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駐車場の画面を更新してから、もう一度オンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请刷新停车场页面，然后重新开启。"
          }
        }
      }
    },
    "제보와 만차 알림을 켰어요. 최근 10분 동안 만차 제보가 5건 이상 들어오면 하루 한 번 알려 드려요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제보와 만차 알림을 켰어요. 최근 10분 동안 만차 제보가 5건 이상 들어오면 하루 한 번 알려 드려요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporting and full-lot alerts are on. We’ll notify you once a day when at least five full-lot reports arrive within 10 minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状況報告と満車通知をオンにしました。10分以内に満車報告が5件以上届くと、1日1回通知します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启上报和满位提醒。10分钟内收到至少5条满位上报时，每天最多提醒一次。"
          }
        }
      }
    },
    "제보와 만차 알림을 껐어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제보와 만차 알림을 껐어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporting and full-lot alerts are off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状況報告と満車通知をオフにしました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭上报和满位提醒。"
          }
        }
      }
    },
    "교대 시간 한마디": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교대 시간 한마디"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift check-in"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "交替時のひとこと"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交接班留言"
          }
        }
      }
    },
    "이 기기에 저장하지 못했어요. 화면을 닫으면 바꾼 내용이 사라질 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장하지 못했어요. 화면을 닫으면 바꾼 내용이 사라질 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save on this device. Changes may be lost when you close the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末に保存できませんでした。画面を閉じると変更内容が失われることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能保存到此设备。关闭页面后，更改可能会丢失。"
          }
        }
      }
    },
    "여기서 쓴 글과 설정은 이 기기에만 저장돼요. 다른 이용자에게 보내지 않아요. 식단 평가는 오늘 메뉴에서, 통근버스·주차장·분실물은 전체 메뉴에서 이용할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 쓴 글과 설정은 이 기기에만 저장돼요. 다른 이용자에게 보내지 않아요. 식단 평가는 오늘 메뉴에서, 통근버스·주차장·분실물은 전체 메뉴에서 이용할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your posts and settings here are saved only on this device. They aren’t sent to other users. Find meal ratings in Today’s menu, and shuttle buses, parking and lost & found in the All menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで書いた投稿や設定は、この端末だけに保存されます。他の利用者には送信されません。献立評価は「今日の献立」、通勤バス・駐車場・落とし物は「すべて」のメニューから利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的发帖和设置仅保存在此设备上，不会发送给其他用户。请在今日菜单中查看餐点评价，在全部菜单中使用通勤班车、停车场和失物招领。"
          }
        }
      }
    },
    "예시 보기 (작성 시간 제한 없이)": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예시 보기 (작성 시간 제한 없이)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show examples (no posting time limit)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例を見る（投稿時間の制限なし）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看示例（不限发帖时间）"
          }
        }
      }
    },
    "테스트 기록 지우기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테스트 기록 지우기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear test history"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試用の記録を消す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除试用记录"
          }
        }
      }
    },
    "누가 글을 볼 수 있는지 예시로 보여 드려요. 아직 실제 소속이나 열람 권한은 확인하지 않아요. 회사의 공식 승인은 별도로 받아야 해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누가 글을 볼 수 있는지 예시로 보여 드려요. 아직 실제 소속이나 열람 권한은 확인하지 않아요. 회사의 공식 승인은 별도로 받아야 해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The example shows who could view a post. We don’t verify team membership or viewing permissions yet. You’ll still need official company approval."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰が投稿を閲覧できるかを例で示します。実際の所属や閲覧権限はまだ確認しません。会社の正式な承認は別途必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例展示哪些人可以查看帖子。此功能尚未验证实际归属或查看权限。仍需另行获得公司的正式批准。"
          }
        }
      }
    },
    "동료가 지원하면 요청자가 선택하고, 두 사람이 확인하면 확정해요. 여기서는 실제 지원이 전송되지 않아요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동료가 지원하면 요청자가 선택하고, 두 사람이 확인하면 확정해요. 여기서는 실제 지원이 전송되지 않아요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A coworker volunteers, the requester chooses them, and both confirm. This preview doesn’t send an actual response."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同僚が応募し、依頼した人が選び、双方が確認すると確定します。このプレビューでは実際の応募は送信されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同事报名后，请求者选择人选，双方确认后才确定。这里不会发送实际报名。"
          }
        }
      }
    },
    "잠들기 몇 시간 전에 알릴지 정해 보세요. 체험 중에는 앱을 열어 둔 동안만 알림을 받을 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠들기 몇 시간 전에 알릴지 정해 보세요. 체험 중에는 앱을 열어 둔 동안만 알림을 받을 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how many hours before bedtime to get an alert. In this trial, alerts only arrive while the app is open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "就寝の何時間前に通知を受け取るかを選んでください。試用中はアプリを開いている間だけ通知を受け取れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择睡前几小时提醒。在试用期间，只有应用打开时才能收到提醒。"
          }
        }
      }
    },
    "알림 시간이 이미 지났어요. 취침 예정 시간을 다시 선택해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 시간이 이미 지났어요. 취침 예정 시간을 다시 선택해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That alert time has already passed. Choose your planned bedtime again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知時刻はすでに過ぎています。就寝予定時刻を選び直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒时间已过。请重新选择预计就寝时间。"
          }
        }
      }
    },
    "오전 7~9시와 오후 7~9시(한국 시간)에 글을 쓸 수 있어요. 함께 보기에서 출근·퇴근 글을 모아 볼 수 있어요. 글과 응원은 이 기기에만 저장돼요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오전 7~9시와 오후 7~9시(한국 시간)에 글을 쓸 수 있어요. 함께 보기에서 출근·퇴근 글을 모아 볼 수 있어요. 글과 응원은 이 기기에만 저장돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can post from 7 to 9 a.m. and 7 to 9 p.m. Korea time. Show both brings together posts from people arriving and leaving. Posts and reactions are saved only on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "韓国時間の午前7〜9時と午後7〜9時に投稿できます。「まとめて見る」では出勤と退勤の投稿を一緒に見られます。投稿や応援はこの端末だけに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "韩国时间上午7～9点和晚上7～9点可以发帖。选择一起查看，就能同时看到上班和下班的留言。帖子和鼓励仅保存在此设备上。"
          }
        }
      }
    },
    "지금은 글을 읽을 수 있어요. 오전 7~9시와 오후 7~9시(한국 시간)에 글을 쓸 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 글을 읽을 수 있어요. 오전 7~9시와 오후 7~9시(한국 시간)에 글을 쓸 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can read posts now. Posting opens from 7 to 9 a.m. and 7 to 9 p.m. Korea time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今は投稿を読めます。韓国時間の午前7〜9時と午後7〜9時に投稿できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在可以阅读帖子。韩国时间上午7～9点和晚上7～9点可以发帖。"
          }
        }
      }
    },
    "출근 중인가요, 퇴근 중인가요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출근 중인가요, 퇴근 중인가요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you arriving for work or heading home?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出勤中ですか、退勤中ですか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是在上班路上，还是下班路上？"
          }
        }
      }
    },
    "이 기기의 글, 설정, 검토 결과를 지울까요? 식단 평가는 그대로 남아요. 평가를 취소하려면 오늘 메뉴에서 선택한 버튼을 다시 눌러 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 글, 설정, 검토 결과를 지울까요? 식단 평가는 그대로 남아요. 평가를 취소하려면 오늘 메뉴에서 선택한 버튼을 다시 눌러 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear posts, settings and review choices from this device? Your meal ratings will stay. To undo a rating, tap your selected button again in Today’s menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末の投稿、設定、検討結果を消しますか？献立の評価は残ります。評価を取り消すには「今日の献立」で選んだボタンをもう一度タップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除此设备上的帖子、设置和试用反馈吗？餐点评价会保留。要撤销评价，请在今日菜单中再次点按已选按钮。"
          }
        }
      }
    },
    "함께 보기": {
