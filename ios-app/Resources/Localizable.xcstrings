        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定をもう一度見る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新查看初始设置"
          }
        }
      }
    },
    "25일이 쉬는 날이면 그 전 영업일에 들어와요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "25일이 쉬는 날이면 그 전 영업일에 들어와요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the 25th is a non-business day, pay arrives on the previous business day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "25日が休業日の場合は、直前の営業日に入金されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果25日不是工作日，工资会在前一个工作日到账。"
          }
        }
      }
    },
    "급여 내역 자세히 보기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급여 내역 자세히 보기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View pay breakdown"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "給与明細を見る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看工资明细"
          }
        }
      }
    },
    "정규직으로 전환된 날을 입력해 주세요. 급여 산정 마지막 날인 15일을 기준으로 정규직 1년 미만이면 지원금, 1년 이상이면 상여금으로 계산해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정규직으로 전환된 날을 입력해 주세요. 급여 산정 마지막 날인 15일을 기준으로 정규직 1년 미만이면 지원금, 1년 이상이면 상여금으로 계산해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the date you became a permanent employee. As of the 15th, the last day of the pay period, less than one year of permanent employment counts toward a support payment. One year or more counts toward a bonus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正社員に転換した日を入力してください。給与算定期間の最終日である15日時点で、正社員になって1年未満なら支援金、1年以上なら賞与として計算します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入转正日期。以工资核算期最后一天（15日）为准，转正不满一年按补助金计算，满一年按奖金计算。"
          }
        }
      }
    },
    "정규직으로 전환된 날부터 연차를 계산해요. 첫 1년 동안 한 달을 개근하면 하루씩, 최대 11일을 받아요. 다음 해 1월 1일에 받는 연차는 전년도에 일한 기간에 맞춰 따로 예상해요. 매달 받은 연차부터 사용한 날을 빼요. 매달 받은 연차 중 남은 날은 첫 1년이 끝나면 없어져요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정규직으로 전환된 날부터 연차를 계산해요. 첫 1년 동안 한 달을 개근하면 하루씩, 최대 11일을 받아요. 다음 해 1월 1일에 받는 연차는 전년도에 일한 기간에 맞춰 따로 예상해요. 매달 받은 연차부터 사용한 날을 빼요. 매달 받은 연차 중 남은 날은 첫 1년이 끝나면 없어져요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave accrues from the day you become a permanent employee. In your first year, each month with full attendance earns one day, up to 11 days. Leave granted on January 1 of the next year is estimated separately based on the time you worked in the previous year. Leave taken is deducted from the monthly accrual first. Unused monthly leave expires at the end of your first year."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正社員に転換した日から有休を計算します。最初の1年間は1か月皆勤するごとに1日、最大11日付与されます。翌年1月1日に付与される有休は、前年に働いた期間に応じて別に見積もります。取得した日数は毎月付与された有休から先に差し引きます。その残りは最初の1年が終わると失効します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "年假从转正当天起计算。第一年内每满勤一个月获得一天，最多11天。次年1月1日发放的年假按上一年的在职时间另行估算。已休天数优先从每月获得的年假中扣除，未使用的月度年假在第一年结束时失效。"
          }
        }
      }
    },
    "개근했고 회사가 1월 1일을 기준으로 연차를 준다고 가정한 값이에요. 회사에서 확인한 연차가 다르면 총 연차를 바꿔 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개근했고 회사가 1월 1일을 기준으로 연차를 준다고 가정한 값이에요. 회사에서 확인한 연차가 다르면 총 연차를 바꿔 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This assumes full attendance and that your company grants leave on January 1. If your employer confirms a different amount, update your total leave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "皆勤し、会社が1月1日を基準に有休を付与する前提で計算しています。会社で確認した日数と異なる場合は、有休の合計を変更してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此估算假设您全勤，且公司在1月1日发放年假。如果公司确认的天数不同，请调整年假总天数。"
          }
        }
      }
    },
    "달력에 적은 연차를 자동으로 반영해요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력에 적은 연차를 자동으로 반영해요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave recorded in your calendar is reflected automatically"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーに記録した有休を自動で反映"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历中记录的年假会自动计入"
          }
        }
      }
    },
    "쓴 연차": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓴 연차"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used leave"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用済み有休"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已用年假"
          }
        }
      }
    },
    "해당 기간 쓴 연차": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 기간 쓴 연차"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave used in this period"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象期間に使用した有休"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该期间已休年假"
          }
        }
      }
    },
    "어떤 기록을 사용할까요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 기록을 사용할까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which records would you like to use?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらの記録を使いますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用哪份记录？"
          }
        }
      }
    },
    "이 기기와 계정에 저장한 내용이 달라요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기와 계정에 저장한 내용이 달라요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device and your account have different saved records."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末とアカウントに保存した内容が異なります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备与账户保存的记录不同。"
          }
        }
      }
    },
    "기록 선택 닫기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 선택 닫기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close record selection"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録の選択を閉じる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭记录选择"
          }
        }
      }
    },
    "이어서 쓸 기록을 골라 주세요. 선택한 뒤 바꾼 내용은 자동으로 저장되고, 동시에 저장한 기록도 보관돼요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어서 쓸 기록을 골라 주세요. 선택한 뒤 바꾼 내용은 자동으로 저장되고, 동시에 저장한 기록도 보관돼요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which records to keep using. Later changes save automatically, and records saved at the same time are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き続き使う記録を選んでください。選択後の変更は自動で保存され、同時に保存された記録も保管されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择要继续使用的记录。之后的更改会自动保存，同时保存的记录也会保留。"
          }
        }
      }
    },
    "이 기기의 기록 사용하기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 기록 사용하기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use records from this device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末の記録を使う"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此设备的记录"
          }
        }
      }
    },
    "연결 상태를 확인하고 있어요…": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 상태를 확인하고 있어요…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking connection…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続状況を確認しています…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查连接…"
          }
        }
      }
    },
    "근무표와 날짜 메모를 Google 캘린더에 보내요. 다시 보내면 근무 루틴에 저장한 내용으로 바뀌니, 수정은 근무 루틴에서 해 주세요. 저장한 기록은 Google Drive에서 불러올 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근무표와 날짜 메모를 Google 캘린더에 보내요. 다시 보내면 근무 루틴에 저장한 내용으로 바뀌니, 수정은 근무 루틴에서 해 주세요. 저장한 기록은 Google Drive에서 불러올 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send your shifts and date notes to Google Calendar. Sending them again updates them to what’s saved in Shift Routine, so make edits in Shift Routine. You can restore saved records from Google Drive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務表と日付ごとのメモをGoogleカレンダーに送ります。再送するとシフトルーティンに保存した内容で更新されるので、変更はシフトルーティンで行ってください。保存した記録はGoogle Driveから読み込めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将班表和日期备忘发送到 Google 日历。再次发送时会以轮班日常中保存的内容为准，请在轮班日常中修改。可从 Google Drive 恢复已保存的记录。"
          }
        }
      }
    },
    "근무표 보내기는 원하는 분만 연결하면 돼요. 연결할 때 캘린더 목록을 보고 근무 루틴 전용 캘린더의 일정을 관리할 수 있도록 권한을 요청해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근무표 보내기는 원하는 분만 연결하면 돼요. 연결할 때 캘린더 목록을 보고 근무 루틴 전용 캘린더의 일정을 관리할 수 있도록 권한을 요청해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to send your schedule is optional. We ask permission to view your calendar list and manage events in the Shift Routine calendar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務表の送信は任意です。接続時に、カレンダー一覧の表示とシフトルーティン専用カレンダーの予定の管理に必要な権限を求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以选择是否连接以发送班表。连接时会请求查看日历列表和管理轮班日常专用日历日程的权限。"
          }
        }
      }
    },
    "이번 달 근무표 보내기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 근무표 보내기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this month’s schedule"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の勤務表を送る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送本月班表"
          }
        }
      }
    },
    "이번 달에 빠진 일정 다시 보내기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달에 빠진 일정 다시 보내기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resend missing events for this month"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の送信対象から外れた予定を再送"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新发送本月遗漏的日程"
          }
        }
      }
    },
    "보내기를 중지하거나 연결을 끊어도 이미 보낸 근무표는 남아요. 앱 권한은 Google 계정의 보안 → 연결된 앱에서 해제할 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기를 중지하거나 연결을 끊어도 이미 보낸 근무표는 남아요. 앱 권한은 Google 계정의 보안 → 연결된 앱에서 해제할 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping or disconnecting keeps schedules you already sent. You can remove app access in your Google account under Security → Connected apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信を停止したり接続を解除したりしても、送信済みの勤務表は残ります。アプリの権限はGoogleアカウントの「セキュリティ → 接続済みのアプリ」で解除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止发送或断开连接后，已发送的班表会保留。您可在 Google 账户的“安全 → 已连接的应用”中撤销权限。"
          }
        }
      }
    },
    "근무표나 메모를 바꿀 때는 근무 루틴에서 수정해 주세요. 지금 보고 있는 달의 근무표를 보낼 수 있어요. 자동 보내기를 켜면 내용을 수정하거나 다른 달을 열 때 해당 달의 근무표도 보내요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근무표나 메모를 바꿀 때는 근무 루틴에서 수정해 주세요. 지금 보고 있는 달의 근무표를 보낼 수 있어요. 자동 보내기를 켜면 내용을 수정하거나 다른 달을 열 때 해당 달의 근무표도 보내요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit shifts or notes in Shift Routine. You can send the schedule for the month you’re viewing. With auto-send on, editing something or opening another month sends the schedule for that month too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務表やメモはシフトルーティンで変更してください。表示中の月の勤務表を送信できます。自動送信を有効にすると、内容を編集したり別の月を開いたりしたときに、その月の勤務表も送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在轮班日常中修改班表或备忘。您可以发送当前查看月份的班表。开启自动发送后，修改内容或打开其他月份时，也会发送对应月份的班表。"
          }
        }
      }
    },
    "보고 있는 달의 근무표를 이미지로 보내요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고 있는 달의 근무표를 이미지로 보내요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share this month’s schedule as an image"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中の月の勤務表を画像で共有"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以图片分享正在查看的月度班表"
          }
        }
      }
    },
    "정규직 전환일을 입력하면 연차를 자동으로 계산해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정규직 전환일을 입력하면 연차를 자동으로 계산해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your permanent employment start date to calculate leave automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正社員への転換日を入力すると有休を自動で計算します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入转正日期后会自动计算年假。"
          }
        }
      }
    },
    "총 연차를 0일 이상으로 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "총 연차를 0일 이상으로 입력해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a total leave amount of zero days or more."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有休の合計は0日以上で入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入不少于0天的年假总天数。"
          }
        }
      }
    },
    "이 기기에 저장했어요. Google 계정을 연결하면 다른 기기에서도 이어서 쓸 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장했어요. Google 계정을 연결하면 다른 기기에서도 이어서 쓸 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved on this device. Connect your Google account to continue on other devices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末に保存しました。Googleアカウントを連携すると、別の端末でも続きから使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存到此设备。连接 Google 账户后可在其他设备继续使用。"
          }
        }
      }
    },
    "이 기기에 저장했어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 저장했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末に保存しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存到此设备。"
          }
        }
      }
    },
    "쉬는 날에는 연차, 반차, 무급휴무를 쓰거나 잔업을 뺄 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉬는 날에는 연차, 반차, 무급휴무를 쓰거나 잔업을 뺄 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t use annual leave, half-day leave, or unpaid leave, or remove overtime, on a day off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休日には有休・半休・無給休暇を取ったり、残業を外したりできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "休息日无法使用年假、半天假或无薪休假，也无法取消延时加班。"
          }
        }
      }
    },
    "주간 근무일에는 야간 특근을 넣을 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 근무일에는 야간 특근을 넣을 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t add an extra night shift on a day shift."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日勤の日には夜勤の特別勤務を追加できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "白班当天无法安排夜班加班。"
          }
        }
      }
    },
    "야간 근무일에는 주간 특근을 넣을 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "야간 근무일에는 주간 특근을 넣을 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t add an extra day shift on a night shift."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜勤の日には日勤の特別勤務を追加できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "夜班当天无法安排白班加班。"
          }
        }
      }
    },
    "전날 야간 근무가 끝난 직후에는 주간 특근을 넣을 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전날 야간 근무가 끝난 직후에는 주간 특근을 넣을 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t add an extra day shift right after the previous night’s shift ends."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前日の夜勤が終わった直後に日勤の特別勤務は追加できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前一晚的夜班结束后，不能紧接着安排白班加班。"
          }
        }
      }
    },
    "다음 날 주간 특근이 있어 야간 특근을 넣을 수 없어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 날 주간 특근이 있어 야간 특근을 넣을 수 없어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t add an extra night shift when an extra day shift is scheduled for the next day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翌日に日勤の特別勤務があるため、夜勤の特別勤務を追加できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "次日已安排白班加班，无法添加夜班加班。"
          }
        }
      }
    },
    "한 달에 무급휴무 1번 또는 무급반차 2번까지 쓸 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 달에 무급휴무 1번 또는 무급반차 2번까지 쓸 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can take one unpaid day or up to two unpaid half-days per month."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1か月に無給休暇を1日、または無給の半休を2回まで取得できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月可休1天无薪假，或最多2次无薪半天假。"
          }
        }
      }
    },
    "입력한 값을 초기화했어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력한 값을 초기화했어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your entries were reset."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力した値をリセットしました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已重置输入内容。"
          }
        }
      }
    },
    "입사일 (정규직 기준)": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입사일 (정규직 기준)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start date (permanent employment)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入社日（正社員基準）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入职日期（正式员工）"
          }
        }
      }
    },
    "계약직이라면 처음 입사한 날을 골라 주세요. 정규직으로 전환되면 전체 → 연차 설정에서 날짜를 바꿀 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계약직이라면 처음 입사한 날을 골라 주세요. 정규직으로 전환되면 전체 → 연차 설정에서 날짜를 바꿀 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you’re a contract employee, choose the day you first joined. After becoming permanent, you can change it in All → Annual leave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "契約社員の方は最初に入社した日を選んでください。正社員への転換後に「すべて → 有休設定」で変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合同员工请选择首次入职日期。转正后可在“全部 → 年假设置”中更改。"
          }
        }
      }
    },
    "받는 수당이 있을 때만 금액을 입력해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받는 수당이 있을 때만 금액을 입력해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an amount only if you receive the allowance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け取っている手当がある場合のみ金額を入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有领取津贴时才需要输入金额。"
          }
        }
      }
    },
    "위아래로 넘겨 날짜를 골라 주세요. 키보드 방향키로도 바꿀 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래로 넘겨 날짜를 골라 주세요. 키보드 방향키로도 바꿀 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up or down to choose a date. You can also use the arrow keys."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にスワイプして日付を選びます。キーボードの矢印キーでも変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下滑动选择日期，也可使用键盘方向键。"
          }
        }
      }
    },
    "입사일을 알려 주세요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입사일을 알려 주세요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When did you join?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入社日を教えてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择入职日期"
          }
        }
      }
    },
    "입사일을 기준으로 연차와 예상 급여를 계산해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입사일을 기준으로 연차와 예상 급여를 계산해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We use your start date to calculate leave and estimate pay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入社日をもとに有休と予想給与を計算します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据入职日期计算年假和预估工资。"
          }
        }
      }
    },
    "전에 쓰던 Google 계정으로 로그인하면 근무표, 메모, 설정을 불러와요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전에 쓰던 Google 계정으로 로그인하면 근무표, 메모, 설정을 불러와요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with the Google account you used before to restore shifts, notes and settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前使っていたGoogleアカウントでログインすると、勤務表・メモ・設定を読み込めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录之前使用的 Google 账户即可恢复班表、备忘和设置。"
          }
        }
      }
    },
