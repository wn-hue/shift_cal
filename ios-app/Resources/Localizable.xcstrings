      }
    },
    "받는 수당이 없다면 선택 없이 다음으로 넘어가세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받는 수당이 없다면 선택 없이 다음으로 넘어가세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No allowances? Continue without selecting any."
