          }
        }
      }
    },
    "메모는 저장됐지만 알림 권한이 꺼져 있어요. 아이폰 설정에서 알림을 허용해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모는 저장됐지만 알림 권한이 꺼져 있어요. 아이폰 설정에서 알림을 허용해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your note is saved, but notifications are off. Allow them in iPhone Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモは保存しましたが通知がオフです。iPhoneの設定で通知を許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备注已保存，但通知权限已关闭。请在iPhone设置中允许通知。"
          }
        }
      }
    },
    "메모는 저장됐지만 일부 알림을 예약하지 못했어요. 다시 시도해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모는 저장됐지만 일부 알림을 예약하지 못했어요. 다시 시도해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your note is saved, but some reminders couldn't be scheduled. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモは保存しましたが、一部の通知を予約できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备注已保存，但部分提醒预约失败，请重试。"
          }
