          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从奖金短信导入扣除依据"
          }
        }
      }
    },
    "지급 합계와 공제내역이 포함된 급여 문자를 복사해 주세요. 개인 세금·보험료 추정에만 사용해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지급 합계와 공제내역이 포함된 급여 문자를 복사해 주세요. 개인 세금·보험료 추정에만 사용해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy a salary SMS with payment totals and deductions. It is only used to estimate your personal taxes and insurance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支給合計と控除内訳を含む給与SMSをコピーしてください。個人の税金・保険料の推定にのみ使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请复制包含应发合计和扣除明细的工资短信，仅用于估算个人税费和保险费。"
          }
        }
      }
    },
    "선택 사항이에요. 등록하지 않아도 기본 공제 기준으로 추정해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 등록하지 않아도 기본 공제 기준으로 추정해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Without an import, the default deduction basis is used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意です。登録しない場合は既定の控除基準で推定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。不导入时按默认扣除依据估算。"
          }
        }
      }
    },
