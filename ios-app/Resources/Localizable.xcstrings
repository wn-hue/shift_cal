    },
    "응답이 늦어지고 있어요. 새로고침해서 처리 결과를 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 늦어지고 있어요. 새로고침해서 처리 결과를 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The response is taking longer than usual. Refresh to see whether the action went through."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答に時間がかかっています。更新して処理結果を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应时间较长。请刷新后确认处理结果。"
          }
        }
      }
    },
    "글을 저장했어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글을 저장했어요."
