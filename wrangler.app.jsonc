{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"work-routine",
 "account_id":"32d1066203eb6fac428b7ddcb116eb58",
 "main":"cloudflare/app-worker.mjs",
 "compatibility_date":"2026-11-04",
 "workers_dev":true,
 "routes":[{"pattern":"20261104.xyz","custom_domain":true,"zone_id":"ed713843a1f0097623f7d02fbe1b9698"}],
 "triggers":{"crons":["30-55/5 2 * * *","0-25/5 8 * * *","50,55 15 * * *","0-15/5 16 * * *"]},
 "d1_databases":[{"binding":"LOCAL_FOOD","database_name":"work-routine-data","database_id":"04df2bbb-6df2-4b28-9e20-aac5a867fa07","migrations_dir":"cloudflare/migrations"}],
 "assets":{"directory":".cloudflare-assets","binding":"ASSETS","run_worker_first":["/","/api/*"]}
